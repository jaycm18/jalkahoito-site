---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import ContactForm from "../components/ContactForm.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Footer from "../components/Footer.astro";
import { SITE_DESCRIPTION } from "../config/site";
---

<BaseLayout
	title="Yhteystiedot: jalkahoitaja Helsinki | Jalka-Asema KV"
	description={SITE_DESCRIPTION}
	canonical="/yhteystiedot/"
>
	<Navbar />
	<main id="main-content">
		<section class="py-section">
			<div class="mx-auto max-w-content px-5 md:px-8 lg:px-12">
				<div class="mx-auto max-w-3xl text-center">
					<h1 class="section-title mb-4">Ota yhteyttä jalkahoitajaan Helsingissä</h1>
					<p class="text-muted leading-8">
						Lähetä viesti, jos haluat varata kotikäynnin, kysyä vaativasta jalkahoidosta tai varmistaa palvelualueen.
					</p>
				</div>
			</div>
		</section>
		<ContactForm />
		<ContactCTA />
	</main>
	<Footer />
</BaseLayout>---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout title="Yhteystiedot">
  <Navbar />
  <ContactForm />
</BaseLayout>