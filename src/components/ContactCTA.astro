---
import Container from "./Container.astro";
import Section from "./Section.astro";
---

<Section class="surface-section text-white" style="--surface: #35524a;">
  <Container>
    <div class="mx-auto max-w-3xl rounded-[1.75rem] px-4 py-2 text-center sm:px-8 sm:py-6">
      <h2 class="text-3xl md:text-4xl font-serif mb-4 text-white">
        Tarvitsetko jalkojenhoitoa kotiin Helsingissä?
      </h2>
      <p class="mx-auto max-w-2xl text-base leading-8 text-white/85">
        Ota yhteyttä, jos etsit jalkahoitajaa Helsinkiin tai haluat varata kotikäynnin vaativaan jalkahoitoon.
      </p>
      <div class="mt-6">
        <a href="/yhteystiedot/" class="btn-light">Siirry yhteystietoihin</a>
      </div>
    </div>
  </Container>
</Section>