---
import Container from "./Container.astro";
import {
	CONTACT_EMAIL,
	CONTACT_PHONE,
	CONTACT_PHONE_E164,
	SERVICE_AREA,
	SITE_NAME,
} from "../config/site";
---

<footer class="bg-neutral-900 text-neutral-300 py-14 sm:py-16" aria-label="Sivuston alatunniste">
	<Container>
		<div class="grid gap-8 text-sm leading-7 md:grid-cols-4 md:gap-12">
			<div>
				<h3 class="mb-3 font-serif text-lg text-white">{SITE_NAME}</h3>
				<p class="max-w-sm text-neutral-400">Jalkojenhoitoa kotiin Helsingissä, kotikäynneillä ja yksilöllisellä otteella.</p>
			</div>

			<div>
				<h3 class="mb-3 font-semibold text-white">Palvelut</h3>
				<nav class="flex flex-col gap-1">
					<a class="text-neutral-400 hover:text-white" href="/palvelut/">Jalkojenhoito</a>
					<a class="text-neutral-400 hover:text-white" href="/hinnasto/">Hinnasto</a>
					<a class="text-neutral-400 hover:text-white" href="/yhteystiedot/">Yhteystiedot</a>
				</nav>
			</div>

			<div>
				<h3 class="mb-3 font-semibold text-white">Yhteystiedot</h3>
				<address class="not-italic text-neutral-400">
					<p><a class="hover:text-white" href={`tel:${CONTACT_PHONE_E164}`}>{CONTACT_PHONE}</a></p>
					<p><a class="hover:text-white" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
					<p>{SERVICE_AREA}</p>
				</address>
			</div>

			<div>
				<h3 class="mb-3 font-semibold text-white">Yritystiedot</h3>
				<p>Y-tunnus: 3619518-8</p>
			</div>
		</div>

		<div class="mt-8 text-center text-xs text-neutral-500">© 2026 Jalka-Asema KV</div>
	</Container>
</footer>
